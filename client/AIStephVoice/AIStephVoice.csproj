<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AIStephVoice</AssemblyName>
    <RootNamespace>AIStephVoice</RootNamespace>
    <ApplicationIcon>Assets\AIStephVoice.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Product>AISteph Voice</Product>
    <Description>Local-first voice capture and analysis workspace</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AIStephVoice.ico" />
    <Resource Include="Assets\AIStephVoice.png" />
    <Content Include="..\..\src\**\*.*" Link="runtime\src\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\VERSION" Link="runtime\VERSION" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\package.json" Link="runtime\package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>