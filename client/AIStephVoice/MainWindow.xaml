<Window x:Class="AIStephVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AISteph Voice"
        Icon="Assets/AIStephVoice.ico"
        Width="1280"
        Height="860"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F6F5F4">
    <Grid>
        <wv2:WebView2 x:Name="WorkspaceView" DefaultBackgroundColor="#F6F5F4" />
        <Border x:Name="LoadingPanel" Background="#0A1530">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Assets/AIStephVoice.png" Width="72" Height="72" Margin="0,0,0,22" />
                <TextBlock Text="AISteph Voice" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingMessage" Text="正在启动本地录音工作区…" Foreground="#C9D0DF" FontSize="14" Margin="0,12,0,18" HorizontalAlignment="Center" />
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" Foreground="#2E9B64" Background="#263757" />
            </StackPanel>
        </Border>
    </Grid>
</Window>